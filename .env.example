# Copy this file to .env and fill in the values. Never commit .env.

# --- Authentication ---------------------------------------------------
# Signing secret for JWTs. Must be at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_AUTH_SECRET=

# Browser origins allowed to call the API (comma-separated, no wildcard).
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Bootstrap admin (used only to create the first database admin account).
# Generate the hash with:  python reset_admin_password.py
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD_HASH=

# --- MySQL (users, chat sessions, document registry, revoked tokens) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rag_assistant
MYSQL_USER=
MYSQL_PASSWORD=

# Optional connection-pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
SQL_ECHO=false

# --- Ollama ------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# --- Evaluation scripts ------------------------------------------------
# Username whose private knowledge base the eval scripts should query.
RAG_EVAL_OWNER_ID=
